# 이우드림무역 자금관리 — 실행 설정
#
# 「시작.bat」 이 이 파일을 .env.docker 로 복사해서 씁니다.
# 비밀번호를 바꾸시려면 .env.docker 를 메모장으로 열어 고치신 뒤
# 「자료초기화.bat」 → 「시작.bat」 순서로 다시 실행하세요.

# 관리자 비밀번호 (테스트용)
SEED_ADMIN_PASSWORD=yiwu-test-2026!

# 데이터베이스 비밀번호 — 이 PC 안에서만 쓰입니다
DB_PASSWORD=yd-local-db-2026

# 로그인 보안키. 비워 두면 첫 실행 때 자동으로 만들어 보관합니다.
AUTH_SECRET=
