# Railway 에 넣을 값들 — Railway 화면의 Variables 탭에 하나씩 붙여 넣습니다.
#
# DATABASE_URL 은 직접 적지 않습니다.
# Postgres 를 붙이면 Railway 가 알아서 넣어 줍니다.

# 첫 관리자(admin) 비밀번호. 반드시 바꿔서 넣으세요.
SEED_ADMIN_PASSWORD=여기에_새_비밀번호

# 시연 자료를 넣을지.
#   1 = 가짜 거래를 채워 넣습니다 (처음 구경할 때)
#   0 = 빈 상태로 시작합니다 (실제로 쓰기 시작할 때)
SEED_DEMO=1

# 시연 자료를 지우고 빈 장부로 되돌릴 때만 넣습니다.
# 넣은 값으로는 딱 한 번만 지웁니다 — 지우는 걸 깜빡해도 장부가 날아가지 않습니다.
# 다시 비우시려면 값을 다른 것으로 바꾸십시오 (1 → 2).
# RESET_DATA=1

# ── 아래는 넣지 않아도 됩니다 ────────────────────────────
# AUTH_SECRET   로그인 보안키. 비워 두면 처음 켤 때 만들어 DB에 보관합니다.
# COOKIE_SECURE Railway 에서는 자동으로 true 가 됩니다.
# PORT          Railway 가 알아서 정합니다.
