# 운영 배포 시 반드시 값을 바꾸세요.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/yiwudream?schema=public"
# openssl rand -base64 32 로 생성한 값을 넣으세요 (32자 이상)
AUTH_SECRET="CHANGE_ME"
# HTTPS로 서비스하면 true. 사내망 http 운영이면 false.
COOKIE_SECURE="false"

# 검증(npm run verify) 전용 DB. 운영 DB와 반드시 달라야 합니다.
#   createdb yiwudream_test
# DB 이름에 test 가 들어가지 않으면 ALLOW_TEST_ON_THIS_DB=<이름> 도 함께 넣어야 실행됩니다.
TEST_DATABASE_URL="postgresql://사용자@localhost:5432/yiwudream_test?schema=public"
