{
  "name": "yiwudream-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push && npm run db:sql",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:guards": "npm run db:sql",
    "verify": "tsx scripts/verify.ts && tsx scripts/verify-phase2.ts && tsx scripts/verify-phase3.ts && tsx scripts/verify-phase4.ts",
    "smoke": "node scripts/smoke.mjs",
    "db:sql": "for f in prisma/sql/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" >/dev/null; done && echo 'SQL 보호장치·채번 적용 완료'",
    "db:purge-test": "tsx scripts/purge-test-data.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "decimal.js": "^10.4.3",
    "jose": "^5.9.6",
    "next": "15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
